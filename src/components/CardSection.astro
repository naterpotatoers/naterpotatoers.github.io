---
import { getCollection, render } from "astro:content";
import { byOrder } from "@/lib/collections";
import Section from "@/components/Section.astro";
import Card from "@/components/Card.astro";

interface Props {
  id: string;
  title: string;
  icon: string;
  collection: "jobs" | "projects" | "education" | "books";
  grid?: boolean;
}

const { id, title, icon, collection, grid = false } = Astro.props;

const rendered = await Promise.all(
  byOrder(await getCollection(collection)).map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
  })),
);
---

<Section id={id} title={title} icon={icon}>
  <div class={grid ? "grid gap-4 md:grid-cols-2" : "flex flex-col gap-4"}>
    {
      rendered.map(({ data, Content }) => (
        <Card {...data} compact={grid}>
          <Content />
        </Card>
      ))
    }
  </div>
</Section>
