---
import Link from "@/components/Link.astro";
import Badge from "@/components/Badge.astro";
import Location from "@/components/Location.astro";
import Prose from "@/components/Prose.astro";
import BadgeGroup from "@/components/BadgeGroup.astro";

interface Props {
  title: string;
  org?: string;
  date?: string;
  url?: string;
  location?: string;
  tags?: string[];
}

const { date, title, url, org, tags = [], location } = Astro.props;
---

<div class="card border shadow-md my-2 tracking-tighter">
  <div class="card-body">
    <span class="flex justify-between items-center">
      <span class="flex">
        <h2 class="font-bold">{org} <span class="font-thin">{title}</span></h2>
        {url && <Link url={url} />}
      </span>
      {date && <Badge text={date} />}
    </span>
    {location && <Location location={location} />}
    <Prose><slot /></Prose>
    <BadgeGroup tags={tags} />
  </div>
</div>
