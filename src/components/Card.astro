---
import Link from "@/components/Link.astro";
import Badge from "@/components/Badge.astro";
import Location from "@/components/Location.astro";
import Prose from "@/components/Prose.astro";
import BadgeGroup from "@/components/BadgeGroup.astro";

interface Props {
  title: string;
  org?: string;
  date?: string;
  url?: string;
  location?: string;
  tags?: string[];
  compact?: boolean;
}

const {
  date,
  title,
  url,
  org,
  tags = [],
  location,
  compact = false,
} = Astro.props;
---

<article class="card h-full border border-gray-200 shadow-md tracking-tighter">
  <div class:list={["card-body text-base", compact ? "p-6" : "p-8"]}>
    <div class="flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center">
        <h3 class="font-bold">{org} <span class="font-light">{title}</span></h3>
        {url && <Link url={url} />}
      </div>
      {date && <Badge text={date} />}
    </div>
    {location && <Location location={location} />}
    <Prose><slot /></Prose>
    <BadgeGroup tags={tags} />
  </div>
</article>
