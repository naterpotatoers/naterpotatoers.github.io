---
import { Icon } from "astro-icon/components";
---

<script>
  const toggle = document.querySelector<HTMLInputElement>("#theme-toggle")!;
  const root = document.documentElement;
  toggle.checked = root.dataset.theme === "lofi";
  toggle.addEventListener("change", () => {
    const theme = toggle.checked ? "lofi" : "black";
    root.dataset.theme = theme;
    localStorage.setItem("theme", theme);
  });
</script>

<div class="flex items-center fixed top-4 right-4 md:top-8 md:right-8 z-10">
  <Icon name="carbon:moon" class="w-5 h-5" />
  <input
    id="theme-toggle"
    type="checkbox"
    class="toggle toggle-sm mx-1 bg-secondary"
    aria-label="Toggle light and dark theme"
  />
  <Icon name="carbon:sun" class="w-5 h-5" />
</div>
