---
import { getCollection } from "astro:content";
import { byOrder } from "@/lib/collections";
import ContactCard from "@/components/ContactCard.astro";

const contact = byOrder(await getCollection("contact"));
---

<footer class="flex flex-wrap gap-2 justify-center py-16">
  {
    contact.map((item) => (
      <ContactCard
        url={item.data.url}
        label={item.data.title}
        icon={item.data.icon}
      />
    ))
  }
</footer>
