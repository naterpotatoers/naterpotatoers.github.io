---
import { getEntry, render } from "astro:content";
import Dropdown from "@/components/Dropdown.astro";
import Prose from "@/components/Prose.astro";
import CardSection from "@/components/CardSection.astro";

const about = (await getEntry("about", "about"))!;
const { Content: AboutContent } = await render(about);
---

<div class="flex flex-col gap-1">
  <Dropdown title="About" icon="carbon:identification">
    <Prose><AboutContent /></Prose>
  </Dropdown>
  <CardSection
    title="Work Experience"
    icon="carbon:construction"
    collection="jobs"
  />
  <CardSection title="Projects" icon="carbon:tools" collection="projects" />
  <CardSection
    title="Education"
    icon="carbon:education"
    collection="education"
  />
  <CardSection title="Books" icon="carbon:book" collection="books" />
</div>
