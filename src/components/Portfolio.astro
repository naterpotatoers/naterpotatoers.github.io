---
import { getEntry, render } from "astro:content";
import Section from "@/components/Section.astro";
import Prose from "@/components/Prose.astro";
import CardSection from "@/components/CardSection.astro";

const about = (await getEntry("about", "about"))!;
const { Content: AboutContent } = await render(about);
---

<div class="flex flex-col gap-12 px-4 py-8">
  <Section id="about" title="About" icon="carbon:identification">
    <Prose><AboutContent /></Prose>
  </Section>
  <CardSection
    id="work"
    title="Work Experience"
    icon="carbon:construction"
    collection="jobs"
  />
  <CardSection
    id="projects"
    title="Projects"
    icon="carbon:tools"
    collection="projects"
    grid
  />
  <div class="grid gap-12 md:grid-cols-2">
    <CardSection
      id="education"
      title="Education"
      icon="carbon:education"
      collection="education"
    />
    <CardSection
      id="books"
      title="Books"
      icon="carbon:book"
      collection="books"
    />
  </div>
</div>
