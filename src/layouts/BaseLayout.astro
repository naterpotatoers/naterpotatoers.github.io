---
import { Font, getImage } from "astro:assets";
import { getCollection, getEntry } from "astro:content";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import profile from "@/assets/profile.jpeg";
import "@/styles/global.css";

interface Props {
  noindex?: boolean;
}

const { noindex = false } = Astro.props;

const about = (await getEntry("about", "about"))!;
const { name, designation, description } = about.data;

const url = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = await getImage({ src: profile, width: 180, format: "jpeg" });
const ogImageUrl = new URL(ogImage.src, Astro.site).toString();

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  jobTitle: designation,
  description,
  image: ogImageUrl,
  url: Astro.site?.toString(),
  sameAs: (await getCollection("contact"))
    .map((entry) => entry.data.url)
    .filter((href) => href.startsWith("https://")),
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`Portrait of ${name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <Font cssVariable="--font-inter" preload />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash of the wrong theme
      document.documentElement.setAttribute(
        "data-theme",
        localStorage.getItem("theme") ?? "black",
      );
    </script>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-M7LT1HP143"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-M7LT1HP143");
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <ThemeToggle />
    <Header {...about.data} />
    <main class="mx-auto w-full max-w-5xl flex-1">
      <hr class="border-gray-200" />
      <slot />
    </main>
    <Footer />
  </body>
</html>
