---
import { getImage } from "astro:assets";
import { getEntry } from "astro:content";

import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import profile from "@/assets/profile.png";

interface Props {
  noindex?: boolean;
}

const { noindex = false } = Astro.props;

const about = await getEntry("about", "about");
const { name, description } = about.data;

const url = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = await getImage({ src: profile, width: 600, format: "png" });
const ogImageUrl = new URL(ogImage.src, Astro.site).toString();
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImageUrl} />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash of the wrong theme
      document.documentElement.setAttribute(
        "data-theme",
        localStorage.getItem("theme") ?? "black",
      );
    </script>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-M7LT1HP143"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-M7LT1HP143");
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <ThemeToggle />
    <Header {...about.data} />
    <main class="mx-auto w-full max-w-5xl flex-1">
      <hr />
      <slot />
    </main>
    <Footer />
  </body>
</html>
